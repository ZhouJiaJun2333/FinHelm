# ============ 模型：二选一 ============
PROVIDER=openai

# --- OpenAI 兼容（DeepSeek / 千问 / Kimi / 本地 vLLM …）---
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
# 上下文窗口（token）。DeepSeek 是 1M；换别家按官方文档改
OPENAI_CONTEXT_WINDOW=1000000
# 模型自己会不会思考（响应里有 reasoning_content）。不会的填 false，写摘要时会让它先打草稿
OPENAI_NATIVE_THINKING=true
#
# 也可以用阿里云百炼 token plan，一个 key 能用 Qwen / DeepSeek / GLM：
# OPENAI_BASE_URL=https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1
# OPENAI_MODEL=deepseek-v4.1-flash      （qwen3.6-flash 窗口 983616，glm-5.3 窗口 1048576）

# --- Claude（改 PROVIDER=anthropic 再用）---
# ANTHROPIC_API_KEY=sk-ant-xxxx
# ANTHROPIC_MODEL=claude-opus-5

# ============ 数据库 ============
# 注意端口是 5433（docker-compose 里映射的），账号是只读的 agent_ro
DATABASE_URL=postgresql://agent_ro:agent_ro_pwd@localhost:5433/analytics
DB_SCHEMA=shop
DB_STATEMENT_TIMEOUT_MS=30000

# ============ Agent ============
MAX_STEPS=12
MAX_TOKENS=8192
