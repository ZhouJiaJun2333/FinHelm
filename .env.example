# ============ 模型：二选一 ============
PROVIDER=openai

# --- OpenAI 兼容（DeepSeek / 千问 / Kimi / 本地 vLLM …）---
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
# 上下文窗口（token）。DeepSeek 是 1M；换别家按官方文档改
OPENAI_CONTEXT_WINDOW=1000000
# 模型自己会不会思考（响应里有 reasoning_content）。不会的填 false，写摘要时会让它先打草稿
OPENAI_NATIVE_THINKING=true
# 模型能不能看图（deepseek-flash 能，deepseek-v4-pro 不能）。不能的填 false，不然它会收到图片然后回答「看不了」
OPENAI_VISION=true
#
# 也可以用阿里云百炼 token plan，一个 key 能用 Qwen / DeepSeek / GLM：
# OPENAI_BASE_URL=https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1
# OPENAI_MODEL=deepseek-v4.1-flash      （qwen3.6-flash 窗口 983616，glm-5.3 窗口 1048576）

# --- Claude（改 PROVIDER=anthropic 再用）---
# ANTHROPIC_API_KEY=sk-ant-xxxx
# ANTHROPIC_MODEL=claude-opus-5

# ============ 数据库 ============
# 注意端口是 5433（docker-compose 里映射的），账号是只读的 agent_ro。留空 = 不连库，只分析文件
DATABASE_URL=postgresql://agent_ro:agent_ro_pwd@127.0.0.1:5433/analytics
# 只看这个 schema（比如 shop）。留空 = 库里所有有表的 schema（本地库里是 shop 和 financial）
DB_SCHEMA=
DB_STATEMENT_TIMEOUT_MS=30000

# ============ 项目 ============
# 项目目录：里面的 AGENTS.md 写数据是什么、业务口径，原样拼进系统提示词。没有 AGENTS.md 也能跑
PROJECT_DIR=examples/demo
# 只读挂进沙箱 /data/ 的数据目录（手册、CSV…）。留空 = 没有，只能分析 /attach 上传的文件
DATA_DIR=

# ============ 长期记忆 ============
# 跨会话记住你定过的口径和偏好。用户级在 <MEMORY_DIR>/memory/，项目级在 <MEMORY_DIR>/projects/<项目路径>/memory/
MEMORY_ENABLED=true
MEMORY_DIR=~/.finhelm

# ============ 中途提问 ============
# 口径有几种理解、算出来差很多时，它会停下来问你（ask_user），回答完同一轮接着做。没人回答的批处理设成 false
ASK_USER=true

# ============ MCP（外部工具服务器）============
# 配置默认读 <PROJECT_DIR>/.mcp.json（格式同 Claude Code），MCP_CONFIG 可以指定别的文件。
# 外部工具第一次调用会问你；.mcp.json 里 autoApprove 列出的不问
MCP_ENABLED=true
MCP_CONFIG=
MCP_TIMEOUT_S=120

# ============ 知识库（RAG）============
# 要检索的文档目录（PDF），几个用 ; 隔开，知识库名 = 目录名。配了才有 list_docs / search_docs / read_doc。
# 目录下可以放 metadata.jsonl（每行 {"doc": 文档名, "company": ..., "period": ...}）
DOCS_DIRS=
# 索引、解析缓存、向量缓存（文档多了有几个 G）。按文档目录分开存，几个项目挂同一个目录共用一份
RAG_DIR=~/.finhelm/rag
# 留空 = 只用 BM25 / 不重排（没有显卡时建议都留空）
RAG_EMBEDDER=BAAI/bge-m3
RAG_RERANKER=BAAI/bge-reranker-v2-m3
# 嵌入、重排模型从 Hugging Face 缓存读（sentence-transformers）。下载：python -c "from huggingface_hub import snapshot_download as S; S('BAAI/bge-m3')"
# HF_HUB_CACHE=D:\models\hub
# 下好之后设成 1：加载时不联网检查更新
# HF_HUB_OFFLINE=1

# ============ 沙箱（run_python / run_r）============
# 先建镜像：docker build -t finhelm-sandbox docker/sandbox。没有 Docker 就设成 false，只剩 SQL 工具
PYTHON_SANDBOX=true
# 开着就注册 run_r：docker build -t finhelm-sandbox-r docker/sandbox-r
R_SANDBOX=true
SANDBOX_TIMEOUT_S=60
SANDBOX_MEMORY=2g

# ============ Agent ============
MAX_STEPS=12
# 步数用完时怎么收尾：report = 确定的照实说、没做完的说清楚做到哪一步；best_guess = 按最合理的假设给出答案
WRAP_UP=report
# 一次回复的输出上限（思考 token 也算在内）。列上百行的清单时 8192 会被截断
MAX_TOKENS=32768
